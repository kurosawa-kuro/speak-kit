# speak-kit の環境変数。値はコミットしない（Vercel の Environment Variables、またはローカルのシェルで渡す）。

# DB の種類: local（既定） / supabase
SPEAK_KIT_DATABASE_KIND=
# 接続文字列。local は speak_kit、supabase は接続プーラーのトランザクションモード（ポート 6543）の postgres
# 例: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
SPEAK_KIT_DATABASE_URL=
# 1 プロセスあたりの DB 接続の上限（既定: local 10、supabase 3）
SPEAK_KIT_DATABASE_POOL_MAX=

# 合言葉（Basic 認証のパスワード。ユーザー名は何でもよい）。Vercel では必須で、未設定なら誰にも開かない
SPEAK_KIT_PASSWORD=

# 任意。無くてもクイズと学習記録は使える
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
