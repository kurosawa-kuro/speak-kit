{
  "name": "speak-kit",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "NEXT_DIST_DIR=.next-build next build",
    "start": "NEXT_DIST_DIR=.next-build next start -p 3000",
    "test": "sh scripts/reset-test-db.sh && SPEAK_KIT_DATABASE_URL=postgresql://kurosawa@localhost:5432/speak_kit_test node --test --test-concurrency=1 src/test/*.test.mjs",
    "data:check": "node src/cli/data.mjs check",
    "data:sync": "node src/cli/data.mjs sync",
    "data:export": "node src/cli/data.mjs export",
    "db:apply": "sh scripts/db-apply.sh speak_kit"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "next": "^15.5.4",
    "pg": "^8.16.3",
    "postcss": "^8.5.30",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.1"
  }
}
